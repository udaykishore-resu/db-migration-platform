# Copy to .env and fill in. Secrets never live in the committed config file.
MIGRATION_ID=db2-to-aurora-pg
ENVIRONMENT=development

TARGET_DSN=postgres://migration:migration@localhost:5432/target?sslmode=disable
SOURCE_DSN=postgres://migration:migration@localhost:5433/source?sslmode=disable

KAFKA_BROKERS=localhost:9092

# Development only. In production use the kms or pkcs11 key source; the config
# validator refuses the static source when environment is "production".
# Generate with: make genkey
MIGRATION_STATIC_KEY=

LOG_LEVEL=info
ADMIN_ADDR=:9090
